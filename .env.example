# Configuration Proxmox MCP Server
# Copier ce fichier vers .env et modifier les valeurs

# =============================================================================
# Connexion Proxmox (obligatoire)
# =============================================================================

# Adresse IP ou hostname du serveur Proxmox (sans https://, sans port)
PROXMOX_HOST=192.168.1.10

# Port de l'API Proxmox (défaut: 8006)
PROXMOX_PORT=8006

# =============================================================================
# Authentification - Option 1 : Token API (recommandé)
# =============================================================================
# Créer un token dans Proxmox: Datacenter > Permissions > API Tokens
# Format token_id: user@realm!token-name

PROXMOX_TOKEN_ID=root@pam!mcp-token
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# Authentification - Option 2 : User/Password
# =============================================================================
# Utilisé uniquement si les variables TOKEN ne sont pas définies
# Moins sécurisé que les tokens API

# PROXMOX_USER=root@pam
# PROXMOX_PASSWORD=votre_mot_de_passe

# =============================================================================
# Options
# =============================================================================

# Vérification du certificat SSL (défaut: false pour les certificats self-signed)
PROXMOX_VERIFY_SSL=false

# Timeout des requêtes en secondes (défaut: 30)
PROXMOX_TIMEOUT=30
